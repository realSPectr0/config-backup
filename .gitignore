# Ignore everything by default
*

# Allow rice/desktop config directories
!.gitignore
!btop/
!btop/**
!cava/
!cava/**
!easyeffects/
!easyeffects/**
!fastfetch/
!fastfetch/**
!fcitx5/
!fcitx5/**
!gtk-3.0/
!gtk-3.0/**
!gtk-4.0/
!gtk-4.0/**
!hypr/
!hypr/**
!kitty/
!kitty/**
!mpd/
!mpd/**
mpd/database
mpd/state
!mpv/
!mpv/**
!nautilus/
!nautilus/**
!nvim/
!nvim/**
!nwg-look/
!nwg-look/**
!quickshell/
!quickshell/**
!ranger/
!ranger/**
!rofi/
!rofi/**
!session/
!session/**
!swaync/
!swaync/**
!wal/
!wal/**
!waybar/
!waybar/**
!wlogout/
!wlogout/**
!xfce4/
!xfce4/**
!xsettingsd/
!xsettingsd/**

# Allow standalone config files
!starship.toml
!mimeapps.list
!user-dirs.dirs

# Ignore generated files and local secrets after directory allow-rules
__pycache__/
*.pyc
.env
*.api_key
.wallhaven_api_key

# Runtime state can reveal local file and wallpaper paths
session/
rofi/wallpaper-colors.rasi
