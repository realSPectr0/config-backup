// Modified from: 24.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/caffyne.txt",
    "type": "auto",
    "color": {
      "1": "#b4befe",
      "2": "#b4befe"
    },
    "padding": {
      "top": 2,
      "left": 4,
      "right": 6,
    },
  },
  "display": {
    "separator": " ",
    "disableLinewrap": true,
    "constants": [
      // CONSTANT {$1} - VERTICAL BARS AT START AND 75th CHARACTERS FORWARD AND BACKWARD
      "\u001b[90m                                                              \u001b[60D\u001b[39m",
      // CONSTANT {$2} - COLOR BACKGROUND FOR KEY
      "\u001b[48;2;43;43;69m",
    ],
    "bar": {
      "char": {
        "elapsed": "=",
        "total": "-",
      },
      "width": 13,
    },
    "percent": {
      "type": 3,
    },
    "color": {
      "title": "#b4befe"
    },
  },
  "modules": [
    // CUSTOM - Top UI bar
    { "type": "custom", "format": "" },
    { "type": "custom", "format": "" },
    {
      "type": "custom",
      "key": "{#90}╭──────────────╮",
      "format": "{#90}╭────────────────────────────────────────────── caffyne.org ╮",
    },
    {
      "type": "title",
      "key": "{#90}│ {#36}  User      {#90} ",
      "format": "{#90}│{$1}{user-name}@{host-name-colored} {#2}· {user-shell}",
    },
    {
      "type": "uptime",
      "key": "{#90}│ {#36}  Uptime    {#90} ",
      "format": "{#90}│{$1}{days}d {hours}h {minutes}m {#2}· local",
    },
    {
      "type": "datetime",
      "key": "{#90}│ {#36}  Datetime  {#90} ",
      "format": "{#90}│{$1}{year}-{month-pretty}-{day-in-month} {hour-pretty}:{minute-pretty}:{second-pretty} {#2}· UTC{offset-from-utc}",
    },
    {
      "type": "host",
      "key": "{#90}│ {#36}  Device    {#90} ",
      "format": "{#90}│{$1}{name} {#2}· {version}",
    },
    {
      "type": "display",
      "key": "{#90}│ {#36}󰍹  Display   {#90} ",
      "format": "{#90}│{$1}{width}x{height}@{refresh-rate}Hz {#2}· {type} · {inch}' · {scale-factor}",
    },
    {
      "type": "kernel",
      "key": "{#90}│ {#35}  Kernel    {#90} ",
      "format": "{#90}│{$1}{sysname}  {#2}· v{release}",
    },
    {
      "type": "os",
      "key": "{#90}│ {#35}󰣇  Distro    {#90} ",
      "format": "{#90}│{$1}{?pretty-name}{pretty-name}{?}{/pretty-name}{name}{/}{codename} {#2}· v{version} · {arch}",
    },
    {
      "type": "wm",
      "key": "{#90}│ {#35}  Desktop   {#90} ",
      "format": "{#90}│{$1}{?pretty-name}{pretty-name}{?}{/pretty-name}{name}{/} {#2}· v{version} · caffyne-shell",
    },
    {
      "type": "terminal",
      "key": "{#90}│ {#35}  Terminal  {#90} ",
      "format": "{#90}│{$1}{pretty-name} {#2}· {version}",
    },
    {
      "type": "packages",
      "key": "{#90}│ {#35}󰏖  Packages  {#90} ",
      "format": "{#90}│{$1}{all} (Total) {#2}· {flatpak-all} (Flatpak)",
    },
    {
      "type": "cpu",
      "key": "{#90}│ {#34}  Processor {#90} ",
      "showPeCoreCount": true,
      "temp": true,
      "format": "{#90}│{$1}{name} {#2}· {core-types} · {freq-max}",
    },
    {
      "type": "gpu",
      "key": "{#90}│ {#34}󰾲  Graphics  {#90} ",
      "detectionMethod": "auto",
      "driverSpecific": true,
      "format": "{#90}│{$1}{name}{?frequency} {#2}· {frequency}{?}",
    },
    {
      "type": "memory",
      "key": "{#90}│ {#34}  Memory    {#90} ",
    },
    {
      "type": "disk",
      "key": "{#90}│ {#34}  Disk      {#90} ",
    },
    {
      "type": "battery",
      "key": "{#90}│ {#34}  Power     {#90} ",
    },
    // CUSTOM - Button UI bar
    {
      "type": "custom",
      "key": "{#90}╰──────────────╯",
      "format": "{#90}╰───────────────────────────────────────────────────────────╯",
    },
    {
      "type": "custom",
      "key": " ",
      "format": "{#90}╭────────────────────────────────────────────────────────────────────────────╮",
    },
    {
      "type": "custom",
      "format": "{#90}│        {#90}  {#31}  {#32}  {#33}  {#34}  {#35}  {#36}  {#39}  {#37}         {#37}  {#39}  {#36}  {#35}  {#34}  {#33}  {#32}  {#31}  {#90}          ",
    },
    {
      "type": "custom",
      "format": "{#90}╰────────────────────────────────────────────────────────────────────────────╯",
    },
  ],
}
