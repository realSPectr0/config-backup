/* Generated by ~/.config/hypr/scripts/rofi-wallpaper-theme.py */
* {
    rofi-bg:              #131316;
    rofi-bg-alt:          #434656;
    rofi-bg-glass:        rgba(19, 19, 22, 0.76);
    rofi-bg-alt-glass:    rgba(67, 70, 86, 0.66);
    rofi-fg:              #e4e1e5;
    rofi-muted:           #c6c5cf;
    rofi-accent:          #bdc4f1;
    rofi-accent-alt:      #e9b8da;
    rofi-selected-bg:     rgba(60, 68, 105, 0.24);
    rofi-selected-strong: rgba(60, 68, 105, 0.38);
    rofi-border:          rgba(233, 184, 218, 0.55);
    rofi-active:          rgba(233, 184, 218, 0.30);
    rofi-urgent:          rgba(60, 68, 105, 0.35);
    rofi-wallpaper-image: url("/home/arch/Documents/.dw/Misc/wallhaven-7jr8jv_1920x1200.png", height);

    background:           @rofi-bg;
    background-alt:       @rofi-bg-alt;
    background-glass:     @rofi-bg-glass;
    background-alt-glass: @rofi-bg-alt-glass;
    foreground:           @rofi-fg;
    selected-bg:          @rofi-selected-bg;
    selected-fg:          @rofi-accent;
    border-col:           @rofi-border;
    selected:             @rofi-selected-strong;
    active:               @rofi-active;
    urgent:               @rofi-urgent;
}
