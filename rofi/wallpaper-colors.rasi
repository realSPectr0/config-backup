/* Generated by ~/.config/hypr/scripts/rofi-wallpaper-theme.py */
* {
    rofi-bg:              #121415;
    rofi-bg-alt:          #3d4850;
    rofi-bg-glass:        rgba(18, 20, 21, 0.76);
    rofi-bg-alt-glass:    rgba(61, 72, 80, 0.66);
    rofi-fg:              #e3e2e3;
    rofi-muted:           #c2c7cc;
    rofi-accent:          #accbe0;
    rofi-accent-alt:      #d8bee0;
    rofi-selected-bg:     rgba(61, 91, 109, 0.24);
    rofi-selected-strong: rgba(61, 91, 109, 0.38);
    rofi-border:          rgba(216, 190, 224, 0.55);
    rofi-active:          rgba(216, 190, 224, 0.30);
    rofi-urgent:          rgba(61, 91, 109, 0.35);
    rofi-wallpaper-image: url("/home/arch/Documents/.dw/Anime/mikuingarden.jpg", height);

    background:           @rofi-bg;
    background-alt:       @rofi-bg-alt;
    background-glass:     @rofi-bg-glass;
    background-alt-glass: @rofi-bg-alt-glass;
    foreground:           @rofi-fg;
    selected-bg:          @rofi-selected-bg;
    selected-fg:          @rofi-accent;
    border-col:           @rofi-border;
    selected:             @rofi-selected-strong;
    active:               @rofi-active;
    urgent:               @rofi-urgent;
}
