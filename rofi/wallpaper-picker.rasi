/**
 * Wallpaper picker rofi theme
 * One row of cards (16:9 preview + filename), filter bar with folder tabs.
 * Colours come from wallpaper-colors.rasi (regenerated per wallpaper).
 **/

@import "/home/arch/.config/rofi/wallpaper-colors.rasi"

* {
    font:               "JetBrainsMono Nerd Font Propo 10";
    text-color:         @rofi-fg;
    background-color:   transparent;
    card-bg:            rgba(255, 255, 255, 0.05);
}

window {
    transparency:       "real";
    location:           center;
    anchor:             center;
    width:              1180px;
    border-radius:      22px;
    border:             2px;
    border-color:       rgba(255, 255, 255, 0.12);
    background-color:   @rofi-bg-glass;
    padding:            18px;
}

mainbox {
    spacing:            18px;
    children:           [ "inputbar", "listview" ];
}

inputbar {
    spacing:            10px;
    padding:            8px 8px 8px 16px;
    border-radius:      12px;
    background-color:   @card-bg;
    children:           [ "textbox-prompt", "entry", "mode-switcher" ];
}

textbox-prompt {
    expand:             false;
    str:                "Select Wallpaper";
    text-color:         @rofi-accent;
    vertical-align:     0.5;
}

entry {
    placeholder:        "Type to filter...";
    placeholder-color:  @rofi-muted;
    cursor:             text;
    vertical-align:     0.5;
}

mode-switcher {
    expand:             false;
    spacing:            4px;
}

button {
    padding:            4px 12px;
    border-radius:      8px;
    text-color:         @rofi-muted;
    cursor:             pointer;
}

button selected {
    background-color:   @rofi-selected-bg;
    text-color:         @rofi-accent;
}

listview {
    columns:            5;
    lines:              1;
    flow:               horizontal;
    cycle:              false;
    dynamic:            false;
    fixed-columns:      true;
    fixed-height:       true;
    scrollbar:          false;
    spacing:            14px;
}

element {
    orientation:        vertical;
    padding:            10px 10px 12px 10px;
    spacing:            0px;
    border-radius:      12px;
    background-color:   @card-bg;
    cursor:             pointer;
}

element-icon {
    size:               196px;
    cursor:             inherit;
}

element-text {
    text-color:         @rofi-fg;
    horizontal-align:   0;
    cursor:             inherit;
}

element selected.normal,
element selected.active {
    background-color:   @rofi-accent;
}

element selected.normal element-text,
element selected.active element-text {
    text-color:         @rofi-bg;
}

element normal.active element-text,
element alternate.active element-text {
    text-color:         @rofi-accent;
}

error-message {
    padding:            20px;
}
