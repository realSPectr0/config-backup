{
    "layer": "top",
    "position": "top",
    "height": 44,
    "spacing": 0,

    "modules-left": [
        "custom/name",
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "custom/music"
    ],
    "modules-right": [
        "backlight",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "clock",
        "group/tray-drawer"
    ],

    // Workspaces
    "hyprland/workspaces": {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    // Taskbar
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "Alacritty"
        ],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        },
        "rewrite": {
            "Firefox Web Browser": "Firefox",
            "Foot Server": "Terminal"
        }
    },

    // Music Player
    "custom/music": {
        "exec": "~/.config/waybar/Scripts/music.sh",
        "return-type": "json",
        "format": "{}",
        "restart-interval": 1,
        "escape": true,
        "on-click": "bash -c 'playerctl play-pause || spotify-launcher'",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // Name label
    "custom/name": {
        "format": "Apps",
        "tooltip": false,
        "on-click": "bash ~/.config/waybar/Scripts/app-launcher.sh"
    },

    // Network
    "network": {
        "format": "{ifname}",
        "format-wifi": "   {signalStrength}%",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "Not connected",
        "tooltip-format": " {ifname} via {gwaddr}",
        "tooltip-format-wifi": "   {essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 50,
        "on-click": "kitty -e nmtui"
    },

    // Battery
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}   {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": [" ", " ", " ", " ", " "]
    },

    // Pulseaudio
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}%  {icon} {format_source}",
        "format-bluetooth-muted": "  {icon} {format_source}",
        "format-muted": "  {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", " ", " "]
        },
        "on-click": "pavucontrol"
    },

    // Bluetooth
    "bluetooth": {
        "format-disabled": "",
        "format-off": "",
        "interval": 30,
        "on-click": "blueman-manager",
        "format-no-controller": "",
        "format": ""
    },

    // Clock
    "clock": {
        "format": "{:%H:%M %a}",
        "on-click": "notify-send -a Calendar Calendar \"$(cal)\"",
        "tooltip": false
    },

    // System tray
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-tray",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": ["custom/tray-toggle", "tray"]
    },

    "custom/tray-toggle": {
        "format": " ",
        "tooltip": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "backlight": {}
}
