{
    "name": "whitewashed",
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "custom/name",
        "hyprland/workspaces",
        "wlr/taskbar"
    ],
    "modules-center": [
        "custom/music"
    ],
    "modules-right": [
        "backlight",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "clock",
        "group/tray-drawer"
    ],

    // Workspaces
    "hyprland/workspaces": {
        "on-click": "activate",
        "active-only": false,
        "all-outputs": false,
        "format": "{}",
        "format-icons": {
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    // Taskbar
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "ignore-list": [
            "Alacritty"
        ],
        "app_ids-mapping": {
            "firefoxdeveloperedition": "firefox-developer-edition"
        },
        "rewrite": {
            "Firefox Web Browser": "Firefox",
            "Foot Server": "Terminal"
        }
    },

    // Music Player
    "custom/music": {
        "exec": "~/.config/waybar/Scripts/music.sh",
        "return-type": "json",
        "format": "{}",
        "max-length": 42,
        "restart-interval": 1,
        "escape": true,
        "on-click": "bash -c 'playerctl play-pause || spotify-launcher'",
        "on-click-right": "playerctl next",
        "on-click-middle": "playerctl previous"
    },

    // Name label
    "custom/name": {
        "format": "󰣇  Apps",
        "tooltip": false,
        "on-click": "bash ~/.config/waybar/Scripts/app-launcher.sh"
    },

    // Network
    "network": {
        "format": "󰈀",
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": " {ifname} via {gwaddr}",
        "tooltip-format-wifi": "   {essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "  {ifname} ({ipaddr}/{cidr})",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 18,
        "on-click": "kitty -e nmtui"
    },

    // Battery
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-alt": "{icon}  {time}",
        "format-icons": [" ", " ", " ", " ", " "]
    },

    // Pulseaudio
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "  {volume}%",
        "format-bluetooth-muted": "  󰝟",
        "format-muted": "󰝟  Muted",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", " ", " "]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    // Bluetooth
    "bluetooth": {
        "format-disabled": "",
        "format-off": "",
        "interval": 30,
        "on-click": "blueman-manager",
        "format-no-controller": "",
        "format": ""
    },

    // Clock
    "clock": {
        "format": "{:%a  %b %d   %I:%M %p}",
        "on-click": "notify-send -a Calendar Calendar \"$(cal)\"",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<b>{}</b>",
                "days": "{}",
                "weeks": "<span color='#9299a8'>W{}</span>",
                "weekdays": "<span color='#7aa2f7'><b>{}</b></span>",
                "today": "<span color='#73daca'><b><u>{}</u></b></span>"
            }
        }
    },

    // System tray
    "group/tray-drawer": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 500,
            "children-class": "not-tray",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": ["custom/tray-toggle", "tray"]
    },

    "custom/tray-toggle": {
        "format": "󰅀",
        "tooltip": false
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    }
}
